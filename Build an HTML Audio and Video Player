4.Build an HTML Audio and Video Player

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>HTML Audio and Video Lab</title>
</head>
<body>

  <h1>Media Player Page</h1>

  <section>
    <h2>Sample Video</h2>
    <video controls width="640">
      <source src="sample-video.mp4" type="video/mp4">
    </video>
  </section>

  <section>
    <h2>Sample Audio</h2>
    <audio controls loop src="sample-audio.mp3"></audio>
  </section>

</body>
</html>
